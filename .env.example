# Copy to .env and fill in. video_gen.py auto-loads ./.env and ~/.video-gen/.env
# (existing values in the shell environment always win, .env only fills gaps).

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json

# Optional overrides
# VIDEO_GEN_MODEL=veo-3.1-lite-generate-001
# VIDEO_GEN_STORAGE_URI=gs://your-bucket/video-gen-output/
